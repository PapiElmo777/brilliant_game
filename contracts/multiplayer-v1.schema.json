{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brilliant:multiplayer:v1",
  "title": "Brilliant multiplayer v1 command and event envelopes",
  "$comment": "Reference a specific $defs schema for each endpoint; domain validation and member authorization are mandatory on the server. Payload snapshots are defined in multiplayer-v1.md.",
  "$defs": {
    "emptyCommand": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "commandId"
      ],
      "additionalProperties": false
    },
    "createRoom": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        }
      },
      "required": [
        "commandId",
        "name",
        "capacity"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "levelId": {
          "oneOf": [
            {
              "enum": [
                "tablero_01",
                "tablero_02",
                "tablero_03",
                "tablero_04"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commandId",
        "expectedRevision",
        "capacity",
        "levelId"
      ],
      "additionalProperties": false
    },
    "configurationCommand": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "commandId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "commandId",
        "expectedRevision",
        "ready"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "commandId",
        "text"
      ],
      "additionalProperties": false
    },
    "preparation": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "placements": {
          "type": "object",
          "minProperties": 6,
          "maxProperties": 6,
          "propertyNames": {
            "pattern": "^f[1-7]_c[1-7]$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        }
      },
      "required": [
        "commandId",
        "placements"
      ],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "PLACE"
            },
            "dieIndex": {
              "enum": [
                0,
                1
              ]
            },
            "cellId": {
              "type": "string",
              "pattern": "^f[1-7]_c[1-7]$"
            }
          },
          "required": [
            "commandId",
            "kind",
            "dieIndex",
            "cellId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "SKIP"
            }
          },
          "required": [
            "commandId",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ballot": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "voteId": {
          "type": "string",
          "format": "uuid"
        },
        "approve": {
          "type": "boolean"
        }
      },
      "required": [
        "commandId",
        "voteId",
        "approve"
      ],
      "additionalProperties": false
    },
    "roomState": {
      "enum": [
        "LOBBY",
        "PREPARING",
        "PLAYING",
        "FINISHED",
        "CLOSED"
      ]
    },
    "matchState": {
      "enum": [
        "PREPARING",
        "ROUND_ACTIVE",
        "END_VOTE",
        "FINISHED",
        "CANCELLED"
      ]
    },
    "commandResponse": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "roomId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "commandId",
        "roomId",
        "sequence",
        "data"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "roomId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "MEMBER_JOINED",
            "MEMBER_LEFT",
            "HOST_CHANGED",
            "SETTINGS_CHANGED",
            "READY_CHANGED",
            "MATCH_STARTED",
            "PREPARATION_CONFIRMED",
            "ROUND_STARTED",
            "ACTION_RESOLVED",
            "ZONE_CLAIMED",
            "MESSAGE_CREATED",
            "END_VOTE_OPENED",
            "END_VOTE_UPDATED",
            "END_VOTE_RESOLVED",
            "MATCH_FINISHED",
            "SNAPSHOT",
            "MEMBER_CONNECTION_CHANGED",
            "REMATCH_ACCEPTED"
          ]
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "protocolVersion",
        "roomId",
        "sequence",
        "type",
        "serverTime",
        "data"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string"
        },
        "userId": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": "string"
        },
        "joinOrder": {
          "type": "integer",
          "minimum": 1
        },
        "ready": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        }
      },
      "required": [
        "memberId",
        "userId",
        "username",
        "joinOrder",
        "ready",
        "connected"
      ],
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "hostMemberId": {
          "type": [
            "string",
            "null"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "levelId": {
          "oneOf": [
            {
              "enum": [
                "tablero_01",
                "tablero_02",
                "tablero_03",
                "tablero_04"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/roomState"
        },
        "members": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      },
      "required": [
        "id",
        "name",
        "hostMemberId",
        "capacity",
        "levelId",
        "revision",
        "state",
        "members"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "rulesVersion": {
          "const": 1
        },
        "roomId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "room": {
          "$ref": "#/$defs/room"
        },
        "match": {
          "oneOf": [
            {
              "$ref": "#/$defs/match"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/chatMessage"
          }
        }
      },
      "required": [
        "protocolVersion",
        "rulesVersion",
        "roomId",
        "sequence",
        "serverTime",
        "room",
        "match",
        "messages"
      ],
      "additionalProperties": false
    },
    "listResponse": {
      "type": "object",
      "properties": {
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "hostName": {
                "type": "string"
              },
              "capacity": {
                "type": "integer",
                "minimum": 2,
                "maximum": 6
              },
              "occupancy": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "levelId": {
                "oneOf": [
                  {
                    "enum": [
                      "tablero_01",
                      "tablero_02",
                      "tablero_03",
                      "tablero_04"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "const": "LOBBY"
              }
            },
            "required": [
              "id",
              "name",
              "hostName",
              "capacity",
              "occupancy",
              "levelId",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "currentRoomId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rooms",
        "currentRoomId"
      ],
      "additionalProperties": false
    },
    "chatMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "PLAYER",
            "SYSTEM"
          ]
        },
        "authorMemberId": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorName": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sequence",
        "kind",
        "authorMemberId",
        "authorName",
        "text",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "historyResponse": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/chatMessage"
          }
        },
        "nextBefore": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "messages",
        "nextBefore"
      ],
      "additionalProperties": false
    },
    "ping": {
      "type": "object",
      "properties": {
        "type": {
          "const": "PING"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "pong": {
      "type": "object",
      "properties": {
        "type": {
          "const": "PONG"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "serverFrame": {
      "oneOf": [
        {
          "$ref": "#/$defs/event"
        },
        {
          "$ref": "#/$defs/pong"
        }
      ]
    },
    "ownAction": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "PLACE",
            "SKIP"
          ]
        },
        "dieIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "cellId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "enum": [
            "PLAYER",
            "TIMEOUT"
          ]
        }
      },
      "required": [
        "kind",
        "dieIndex",
        "cellId",
        "reason"
      ],
      "additionalProperties": false
    },
    "round": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "dice": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedMemberIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ownAction": {
          "oneOf": [
            {
              "$ref": "#/$defs/ownAction"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "number",
        "dice",
        "startedAt",
        "deadline",
        "resolvedMemberIds",
        "ownAction"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "PREPARING",
            "ROUND_ACTIVE",
            "END_VOTE",
            "FINISHED"
          ]
        },
        "levelId": {
          "enum": [
            "tablero_01",
            "tablero_02",
            "tablero_03",
            "tablero_04"
          ]
        },
        "target": {
          "enum": [
            20,
            22,
            24,
            26
          ]
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object"
          }
        },
        "preparedMemberIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ownPreparationConfirmed": {
          "type": "boolean"
        },
        "ownBoard": {
          "type": "object",
          "propertyNames": {
            "pattern": "^f[1-7]_c[1-7]$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "round": {
          "oneOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/matchResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "scores": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/score"
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "zones": {
          "type": "array",
          "maxItems": 49,
          "items": {
            "$ref": "#/$defs/zonePrize"
          }
        },
        "blockedRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "endVote": {
          "oneOf": [
            {
              "$ref": "#/$defs/endVote"
            },
            {
              "type": "null"
            }
          ]
        },
        "rematch": {
          "oneOf": [
            {
              "$ref": "#/$defs/rematchAvailability"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyEntry"
          }
        }
      },
      "required": [
        "id",
        "state",
        "levelId",
        "target",
        "participants",
        "preparedMemberIds",
        "ownPreparationConfirmed",
        "ownBoard",
        "round",
        "result",
        "scores",
        "claims",
        "zones",
        "blockedRounds",
        "endVote",
        "rematch",
        "ownHistory"
      ],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        },
        "joinOrder": {
          "type": "integer",
          "minimum": 1
        },
        "abandoned": {
          "enum": [
            0,
            1
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "completedZones": {
          "type": "integer",
          "minimum": 0
        },
        "scoreSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "memberId",
        "username",
        "joinOrder",
        "abandoned",
        "points",
        "completedZones",
        "scoreSequence"
      ],
      "additionalProperties": false
    },
    "rankingEntry": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        },
        "joinOrder": {
          "type": "integer",
          "minimum": 1
        },
        "abandoned": {
          "enum": [
            0,
            1
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "completedZones": {
          "type": "integer",
          "minimum": 0
        },
        "scoreSequence": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "required": [
        "memberId",
        "username",
        "joinOrder",
        "abandoned",
        "points",
        "completedZones",
        "scoreSequence",
        "position"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "zoneId": {
          "type": "string"
        },
        "memberId": {
          "type": "string",
          "format": "uuid"
        },
        "place": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "zoneId",
        "memberId",
        "place",
        "points",
        "sequence"
      ],
      "additionalProperties": false
    },
    "zonePrize": {
      "type": "object",
      "properties": {
        "zoneId": {
          "type": "string"
        },
        "nextPlace": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "nextPoints": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "zoneId",
        "nextPlace",
        "nextPoints"
      ],
      "additionalProperties": false
    },
    "endBallot": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "format": "uuid"
        },
        "approve": {
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "memberId",
        "approve"
      ],
      "additionalProperties": false
    },
    "endVote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            null,
            "APPROVED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "eligibleMemberIds": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "ballots": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/endBallot"
          }
        }
      },
      "required": [
        "id",
        "startedAt",
        "deadline",
        "outcome",
        "eligibleMemberIds",
        "required",
        "ballots"
      ],
      "additionalProperties": false
    },
    "endVoteResponse": {
      "type": "object",
      "properties": {
        "endVote": {
          "oneOf": [
            {
              "$ref": "#/$defs/endVote"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "endVote"
      ],
      "additionalProperties": false
    },
    "matchResult": {
      "type": "object",
      "properties": {
        "winnerMemberId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
