{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brilliant:multiplayer:v1",
  "title": "Brilliant multiplayer v1 command and event envelopes",
  "$comment": "Reference a specific $defs schema for each endpoint; domain validation and member authorization are mandatory on the server. Payload snapshots are defined in multiplayer-v1.md.",
  "$defs": {
    "emptyCommand": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "commandId"
      ],
      "additionalProperties": false
    },
    "createRoom": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        }
      },
      "required": [
        "commandId",
        "name",
        "capacity"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "levelId": {
          "oneOf": [
            {
              "enum": [
                "tablero_01",
                "tablero_02",
                "tablero_03",
                "tablero_04"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commandId",
        "expectedRevision",
        "capacity",
        "levelId"
      ],
      "additionalProperties": false
    },
    "configurationCommand": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "commandId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "commandId",
        "expectedRevision",
        "ready"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "commandId",
        "text"
      ],
      "additionalProperties": false
    },
    "preparation": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "placements": {
          "type": "object",
          "minProperties": 6,
          "maxProperties": 6,
          "propertyNames": {
            "pattern": "^f[1-7]_c[1-7]$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        }
      },
      "required": [
        "commandId",
        "placements"
      ],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "PLACE"
            },
            "dieIndex": {
              "enum": [
                0,
                1
              ]
            },
            "cellId": {
              "type": "string",
              "pattern": "^f[1-7]_c[1-7]$"
            }
          },
          "required": [
            "commandId",
            "kind",
            "dieIndex",
            "cellId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "SKIP"
            }
          },
          "required": [
            "commandId",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ballot": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "voteId": {
          "type": "string",
          "format": "uuid"
        },
        "approve": {
          "type": "boolean"
        }
      },
      "required": [
        "commandId",
        "voteId",
        "approve"
      ],
      "additionalProperties": false
    },
    "roomState": {
      "enum": [
        "LOBBY",
        "PREPARING",
        "PLAYING",
        "FINISHED",
        "CLOSED"
      ]
    },
    "matchState": {
      "enum": [
        "PREPARING",
        "ROUND_ACTIVE",
        "END_VOTE",
        "FINISHED",
        "CANCELLED"
      ]
    },
    "commandResponse": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "roomId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "commandId",
        "roomId",
        "sequence",
        "data"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "roomId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "MEMBER_JOINED",
            "MEMBER_LEFT",
            "HOST_CHANGED",
            "SETTINGS_CHANGED",
            "READY_CHANGED",
            "MATCH_STARTED",
            "PREPARATION_CONFIRMED",
            "ROUND_STARTED",
            "ACTION_RESOLVED",
            "ZONE_CLAIMED",
            "MESSAGE_CREATED",
            "END_VOTE_OPENED",
            "END_VOTE_UPDATED",
            "END_VOTE_RESOLVED",
            "MATCH_FINISHED"
          ]
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "protocolVersion",
        "roomId",
        "sequence",
        "type",
        "serverTime",
        "data"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string"
        },
        "userId": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": "string"
        },
        "joinOrder": {
          "type": "integer",
          "minimum": 1
        },
        "ready": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        }
      },
      "required": [
        "memberId",
        "userId",
        "username",
        "joinOrder",
        "ready",
        "connected"
      ],
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "hostMemberId": {
          "type": [
            "string",
            "null"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "levelId": {
          "oneOf": [
            {
              "enum": [
                "tablero_01",
                "tablero_02",
                "tablero_03",
                "tablero_04"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/roomState"
        },
        "members": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      },
      "required": [
        "id",
        "name",
        "hostMemberId",
        "capacity",
        "levelId",
        "revision",
        "state",
        "members"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "rulesVersion": {
          "const": 1
        },
        "roomId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "room": {
          "$ref": "#/$defs/room"
        },
        "match": {
          "type": [
            "object",
            "null"
          ]
        },
        "messages": {
          "type": "array"
        }
      },
      "required": [
        "protocolVersion",
        "rulesVersion",
        "roomId",
        "sequence",
        "serverTime",
        "room",
        "match",
        "messages"
      ],
      "additionalProperties": false
    },
    "listResponse": {
      "type": "object",
      "properties": {
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "hostName": {
                "type": "string"
              },
              "capacity": {
                "type": "integer",
                "minimum": 2,
                "maximum": 6
              },
              "occupancy": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "levelId": {
                "oneOf": [
                  {
                    "enum": [
                      "tablero_01",
                      "tablero_02",
                      "tablero_03",
                      "tablero_04"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "const": "LOBBY"
              }
            },
            "required": [
              "id",
              "name",
              "hostName",
              "capacity",
              "occupancy",
              "levelId",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "currentRoomId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rooms",
        "currentRoomId"
      ],
      "additionalProperties": false
    }
  }
}
